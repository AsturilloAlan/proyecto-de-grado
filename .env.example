# Copia este archivo como .env y completa tus propios valores.
# El .env real NUNCA se sube al repositorio ni se comparte (ver .gitignore).

# Django
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USAR_HTTPS=False

# Base de datos MySQL
DB_NAME=auditoria_db
DB_USER=usuario_de_la_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307

# Correo (2FA). Usa una "contraseña de aplicación" de Google, no tu clave personal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
